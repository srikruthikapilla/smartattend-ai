# Backend Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# PostgreSQL Database Connection
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/smartattend

# Redis URL (OTP Storage with TTL)
REDIS_URL=redis://localhost:6379/0
# Or standalone: REDIS_HOST=localhost, REDIS_PORT=6379, REDIS_PASSWORD=

# Brevo (Sendinblue) SMTP Configuration
BREVO_SMTP_SERVER=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USE_SSL=false
BREVO_SMTP_LOGIN=your-brevo-account-email@domain.com
BREVO_SMTP_KEY=your-brevo-smtp-master-key
BREVO_FROM_EMAIL=noreply@sbit.ac.in
BREVO_FROM_NAME=Smart Attend — SBIT

# Security & Hardware Secrets
JWT_SECRET=your-random-jwt-secret-key
EDGE_API_KEY=smartattend-edge-default-key
