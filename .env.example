# =============================================================================
# Smart Attend AI — Production Environment Configuration
# =============================================================================

# PostgreSQL Credentials (Internal Docker Service)
POSTGRES_DB=smartattend
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password

# Backend Database URL (Uses internal container hostname 'postgres')
DATABASE_URL=postgresql://postgres:replace-with-a-strong-postgres-password@postgres:5432/smartattend

# Redis URL (Internal Docker Service for OTP storage with TTL)
REDIS_URL=redis://redis:6379/0

# Brevo (Sendinblue) SMTP Configuration
BREVO_SMTP_SERVER=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=your-brevo-account-email@domain.com
BREVO_SMTP_KEY=your-brevo-smtp-master-key
BREVO_FROM_EMAIL=noreply@sbit.ac.in
BREVO_FROM_NAME=Smart Attend — SBIT

# Application Environment & Ports
NODE_ENV=production
PORT=5000

# Security Secrets (MANDATORY IN PRODUCTION)
JWT_SECRET=replace-with-a-strong-random-secret-key-for-jwt

# Dedicated API Key for offline Edge AI PC sync
EDGE_API_KEY=replace-with-a-secure-edge-sync-key

# Allowed CORS Origins (comma separated list of allowed domains)
CORS_ORIGIN=https://smartattend.yourdomain.com
CORS_ORIGINS=https://smartattend.yourdomain.com,http://localhost:3000

# Frontend API URL (leave empty or /api when behind Nginx reverse proxy)
VITE_API_BASE_URL=/api
