# =============================================================================
# Smart Attend AI — Production Environment Configuration
# Copy this file to the root as .env (gitignored) and fill in real values.
# =============================================================================

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=smartattend
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password

# Backend Database URL (uses internal Docker container hostname 'postgres')
DATABASE_URL=postgresql://postgres:replace-with-a-strong-postgres-password@postgres:5432/smartattend

# ── Redis ────────────────────────────────────────────────────────────────────
# In Coolify / Docker Compose, specify REDIS_URL or use standalone variables:
REDIS_URL=redis://redis:6379/0
# Alternatively, if your Redis has authentication (e.g., managed Redis or Coolify Redis):
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password

# ── Brevo (Sendinblue) SMTP ──────────────────────────────────────────────────
# NOTE FOR COOLIFY / CLOUD VPS HOSTS (Hetzner, DigitalOcean, Linode, AWS):
# Cloud providers frequently BLOCK outbound port 587 by default to prevent spam.
# If port 587 times out, set BREVO_SMTP_PORT=465 and BREVO_SMTP_USE_SSL=true.
# Brevo SMTP Key MUST be created under: Brevo Dashboard -> SMTP & API -> SMTP Keys.
# BREVO_FROM_EMAIL MUST be verified under: Brevo Dashboard -> Senders & IPs -> Senders.
BREVO_SMTP_SERVER=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USE_SSL=false
BREVO_SMTP_LOGIN=your-brevo-account-email@domain.com
BREVO_SMTP_KEY=your-brevo-smtp-master-key
BREVO_FROM_EMAIL=noreply@sbit.ac.in
BREVO_FROM_NAME=Smart Attend — SBIT

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── Security (MANDATORY — app will refuse to start without these in production) ──
# Generate JWT_SECRET with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-strong-random-64-char-secret

# Generate EDGE_API_KEY with: python -c "import secrets; print(secrets.token_urlsafe(32))"
EDGE_API_KEY=replace-with-a-secure-edge-sync-key

# ── Bootstrap Administrator ──────────────────────────────────────────────────
# Used ONLY once on first deployment when no admins exist in the database.
# Change this password immediately after first login.
ADMIN_EMAIL=admin@sbit.ac.in
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# ── CORS ─────────────────────────────────────────────────────────────────────
# Your production domain (the URL users access the app from)
CORS_ORIGIN=https://smartattend.yourdomain.com
CORS_ORIGINS=https://smartattend.yourdomain.com

# ── Frontend (Vite build arg) ─────────────────────────────────────────────────
# Leave as /api — nginx handles the proxy from frontend → backend
VITE_API_BASE_URL=/api
